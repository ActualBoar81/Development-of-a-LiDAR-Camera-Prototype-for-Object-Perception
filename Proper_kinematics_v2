# =========================
# HOMOGENEOUS TRANSFORMS
# =========================
def make_T(R, p):
    T = np.eye(4)
    T[:3, :3] = R
    T[:3, 3] = p
    return T


def inv_T(T):
    R = T[:3, :3]
    p = T[:3, 3]

    T_inv = np.eye(4)
    T_inv[:3, :3] = R.T
    T_inv[:3, 3] = -R.T @ p
    return T_inv


def setup_transforms():
    """
    Background frame {B}:
        X_B = horizontal coordinate on background
        Y_B = vertical coordinate on background
        Z_B = 0 on background plane

    World frame {W}:
        X_W = horizontal
        Y_W = depth/perpendicular to background
        Z_W = vertical

    Mapping:
        X_W = X_B
        Y_W = BACKGROUND_DISTANCE_M
        Z_W = Y_B
    """

    R_WB = np.array([
        [1, 0, 0],
        [0, 0, 1],
        [0, 1, 0]
    ])

    p_WB = np.array([0.0, BACKGROUND_DISTANCE_M, 0.0])
    T_WB = make_T(R_WB, p_WB)

    # LiDAR home frame {L0}
    # Assumption:
    # +Y_L0 points toward background
    # +X_L0 points right
    # +Z_L0 points up
    R_WL0 = np.eye(3)
    T_WL0 = make_T(R_WL0, LIDAR_POS_W_M)

    return T_WB, T_WL0


T_WB, T_WL0 = setup_transforms()
T_L0W = inv_T(T_WL0)

# =========================
# ARDUINO
# =========================
def init_arduino():
    global arduino

    arduino = serial.Serial(ARDUINO_PORT, BAUDRATE, timeout=2)
    time.sleep(2)

    ready = arduino.readline().decode(errors="ignore").strip()
    print("[Arduino]", ready)


def send_angle_and_read_distance(yaw_deg, pitch_deg):
    if arduino is None:
        return None

    yaw_i = round(yaw_deg)
    pitch_i = round(pitch_deg)

    command = f"ANGLE,{yaw_i},{pitch_i}\n"
    print("[Pi -> Arduino]", command.strip())
    arduino.write(command.encode())

    response = arduino.readline().decode(errors="ignore").strip()
    print("[Arduino -> Pi]", response)

    if response.startswith("DIST"):
        distance_raw = float(response.split(",")[1])

        # Assumption: Arduino sends cm.
        # If Arduino sends mm, change to /1000.0.
        return distance_raw / 100.0

    return None

# =========================
# KINEMATICS
# =========================
def clamp(v, vmin, vmax):
    return max(vmin, min(vmax, v))


def background_xy_to_background_point(X, Y):
    X = X * HOMOGRAPHY_OUTPUT_SCALE_TO_M
    Y = Y * HOMOGRAPHY_OUTPUT_SCALE_TO_M

    board_width = (CHECKERBOARD[0] - 1) * SQUARE_SIZE_M
    board_height = (CHECKERBOARD[1] - 1) * SQUARE_SIZE_M

    FLIP_X = True
    FLIP_Y = True

    if FLIP_X:
        X = board_width - X

    if FLIP_Y:
        Y = board_height - Y

    x_B = X
    y_B = Y
    z_B = 0.0

    return np.array([x_B, y_B, z_B, 1.0])


def background_point_to_world(p_B):
    return T_WB @ p_B


def calculate_yaw_pitch_from_world_point(p_W):
    """
    Transform target point from world frame into LiDAR home frame,
    then calculate yaw/pitch.
    """

    p_L0 = T_L0W @ p_W

    x = p_L0[0]
    y = p_L0[1]
    z = p_L0[2]

    yaw_rad = math.atan2(x, y)
    pitch_rad = math.atan2(z, math.sqrt(x**2 + y**2))

    return math.degrees(yaw_rad), math.degrees(pitch_rad), p_L0


def map_to_motor_angles(yaw_kin_deg, pitch_kin_deg):
    yaw_motor = YAW_HOME_DEG + YAW_SIGN * yaw_kin_deg
    pitch_motor = PITCH_HOME_DEG + PITCH_SIGN * pitch_kin_deg

    yaw_motor = clamp(yaw_motor, 0, 180)
    pitch_motor = clamp(pitch_motor, 0, 180)

    return yaw_motor, pitch_motor


def reconstruct_object_point_world(distance_m, yaw_kin_deg, pitch_kin_deg):
    yaw = math.radians(yaw_kin_deg)
    pitch = math.radians(pitch_kin_deg)

    beam_L0 = np.array([
        math.sin(yaw) * math.cos(pitch),
        math.cos(yaw) * math.cos(pitch),
        math.sin(pitch)
    ])

    p_obj_L0 = np.array([
        distance_m * beam_L0[0],
        distance_m * beam_L0[1],
        distance_m * beam_L0[2],
        1.0
    ])

    p_obj_W = T_WL0 @ p_obj_L0
    return p_obj_W.tolist()

# =========================
# MODEL
# =========================
session = ort.InferenceSession(MODEL_PATH, providers=["CPUExecutionProvider"])
input_name = session.get_inputs()[0].name

# =========================
# CAMERA
# =========================
picam2 = Picamera2()
picam2.configure(picam2.create_preview_configuration(main={"size": (640, 480)}))
picam2.start()

# =========================
# PREPROCESS
# =========================
def preprocess(frame):
    img = cv2.resize(frame, (640, 640))
    img = img.astype(np.float32) / 255.0
    img = np.transpose(img, (2, 0, 1))
    return np.expand_dims(img, axis=0)

# =========================
# PIXEL → BACKGROUND COORDINATE
# =========================
def pixel_to_background_xy(cx, cy):
    pt = np.array([[[cx, cy]]], dtype=np.float32)
    mapped = cv2.perspectiveTransform(pt, H)

    X = float(mapped[0][0][0])
    Y = float(mapped[0][0][1])

    return X, Y

# =========================
# DISTANCE BETWEEN BACKGROUND POINTS
# =========================
def dist(a, b):
    return float(np.sqrt((a[0] - b[0])**2 + (a[1] - b[1])**2))

# =========================
# YOLO DECODER + FULL KINEMATIC PREVIEW
# =========================
def parse_detections(outputs, frame):
    global latest

    h, w = frame.shape[:2]
    pred = np.squeeze(outputs[0])

    if len(pred.shape) == 3:
        pred = pred[0]

    if pred.shape[0] < pred.shape[1]:
        pred = pred.T

    objects = []

    for det in pred:
        x, y, bw, bh = det[:4]
        cls_scores = det[4:]

        cls_id = int(np.argmax(cls_scores))
        conf = float(cls_scores[cls_id])

        if conf < CONF_THRES:
            continue

        # Normalize fix
        if x <= 1.5 and y <= 1.5:
            x *= w
            y *= h
            bw *= w
            bh *= h

        x1 = int(x - bw / 2)
        y1 = int(y - bh / 2)
        x2 = int(x + bw / 2)
        y2 = int(y + bh / 2)

        cx = (x1 + x2) // 2
        cy = (y1 + y2) // 2

        try:
            bg_X_raw, bg_Y_raw = pixel_to_background_xy(cx, cy)

            p_B = background_xy_to_background_point(bg_X_raw, bg_Y_raw)
            p_W = background_point_to_world(p_B)
            yaw_kin, pitch_kin, p_L0 = calculate_yaw_pitch_from_world_point(p_W)
            yaw_motor, pitch_motor = map_to_motor_angles(yaw_kin, pitch_kin)

        except Exception:
            bg_X_raw, bg_Y_raw = None, None
            p_B, p_W, p_L0 = None, None, None
            yaw_kin, pitch_kin = None, None
            yaw_motor, pitch_motor = None, None

        obj = {
            "class": classes[cls_id],
            "confidence": round(conf, 2),
            "pixel": [cx, cy],

            "homography_background_raw": [bg_X_raw, bg_Y_raw],

            "p_B_m": None if p_B is None else p_B.tolist(),
            "p_W_m": None if p_W is None else p_W.tolist(),
            "p_L0_m": None if p_L0 is None else p_L0.tolist(),

            "yaw_kinematic_deg": yaw_kin,
            "pitch_kinematic_deg": pitch_kin,
            "motor_preview_deg": [yaw_motor, pitch_motor]
        }

        objects.append(obj)

        # Draw box
        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)

        if p_W is not None:
            label = (
                f"{classes[cls_id]} {conf:.2f} "
                f"W({p_W[0]:.2f},{p_W[1]:.2f},{p_W[2]:.2f}) "
                f"Y:{yaw_motor:.1f} P:{pitch_motor:.1f}"
            )
        else:
            label = f"{classes[cls_id]} {conf:.2f}"

        cv2.putText(
            frame,
            label,
            (x1, y1 - 5),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.45,
            (0, 255, 0),
            2
        )

    # Optional: distance between detected background coordinates
    for i in range(len(objects)):
        for j in range(i + 1, len(objects)):
            a = objects[i]["p_B_m"]
            b = objects[j]["p_B_m"]

            if a is None or b is None:
                continue

            d = dist([a[0], a[1]], [b[0], b[1]])

            cv2.line(
                frame,
                tuple(objects[i]["pixel"]),
                tuple(objects[j]["pixel"]),
                (255, 0, 0),
                1
            )

            print(
                f"{objects[i]['class']} ↔ {objects[j]['class']} "
                f"= {round(d, 3)} m on background plane"
            )

    latest = objects
    return objects, frame

# =========================
# FLASK SERVER
# =========================
app = Flask(__name__)

def generate():
    while True:
        frame = picam2.capture_array()
        frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)

        inp = preprocess(frame)
        outputs = session.run(None, {input_name: inp})

        _, frame = parse_detections(outputs, frame)

        _, buffer = cv2.imencode(".jpg", frame)

        yield (
            b"--frame\r\n"
            b"Content-Type: image/jpeg\r\n\r\n" +
            buffer.tobytes() +
            b"\r\n"
        )

# =========================
# ROUTES
# =========================
@app.route("/")
def home():
    return """
    <h2>YOLO + Homography + Full Kinematics + LiDAR Scan</h2>
    <p>Video: /video</p>
    <p>Data: /data</p>
    <p>One-time scan: /scan</p>
    <img src="/video" width="800">
    """


@app.route("/video")
def video():
    return Response(
        generate(),
        mimetype="multipart/x-mixed-replace; boundary=frame"
    )


@app.route("/data")
def data():
    return jsonify(latest)


@app.route("/scan")
def scan():
    """
    One-time scan.

    MEASURE_ALL_OBJECTS = False:
        scans first detected object.

    MEASURE_ALL_OBJECTS = True:
        scans all detected objects once.
    """

    if len(latest) == 0:
        return jsonify({"error": "No object detected"})

    objects_to_scan = latest.copy() if MEASURE_ALL_OBJECTS else [latest[0]]
    scan_results = []

    for index, obj in enumerate(objects_to_scan, start=1):
        if obj["p_W_m"] is None:
            scan_results.append({
                "object_index": index,
                "error": "No valid world coordinate"
            })
            continue

        p_W = np.array(obj["p_W_m"])

        yaw_kin, pitch_kin, p_L0 = calculate_yaw_pitch_from_world_point(p_W)
        yaw_motor, pitch_motor = map_to_motor_angles(yaw_kin, pitch_kin)

        distance_m = send_angle_and_read_distance(yaw_motor, pitch_motor)

        if distance_m is None:
            scan_results.append({
                "object_index": index,
                "error": "No valid distance received from Arduino"
            })
            continue

        p_obj_W = reconstruct_object_point_world(
            distance_m,
            yaw_kin,
            pitch_kin
        )

        scan_results.append({
            "object_index": index,
            "object": obj["class"],
            "confidence": obj["confidence"],

            "aim_point_background_m": obj["p_B_m"],
            "aim_point_world_m": p_W.tolist(),
            "aim_point_lidar_home_m": p_L0.tolist(),

            "yaw_kinematic_deg": yaw_kin,
            "pitch_kinematic_deg": pitch_kin,
            "yaw_motor_deg": yaw_motor,
            "pitch_motor_deg": pitch_motor,

            "distance_m": distance_m,
            "reconstructed_object_world_m": p_obj_W
        })

    return jsonify({
        "scan_mode": "all_objects_once" if MEASURE_ALL_OBJECTS else "single_object_once",
        "results": scan_results
    })

