# CONFIG
# =========================
MODEL_PATH = "yolov8n.onnx"
HOMOGRAPHY_PATH = "homography.npy"

CONF_THRES = 0.25

# If homography output is already meters, keep 1.0.
# If homography output is centimeters, use 0.01.
HOMOGRAPHY_OUTPUT_SCALE_TO_M = 1.0

# If your homography output origin is already grid/background center, keep True.
# If it is top-left corner of the checkerboard/grid, set False.
HOMOGRAPHY_OUTPUT_IS_CENTERED = True

CHECKERBOARD = (8, 6)
SQUARE_SIZE_M = 0.025

# World frame:
# X = horizontal on background
# Y = depth/perpendicular to background
# Z = vertical
BACKGROUND_DISTANCE_M = 2.0

CAMERA_POS_W_M = np.array([0.09, 0.05, 0.10])
LIDAR_POS_W_M = np.array([0.00, 0.00, 0.09])

YAW_HOME_DEG = 49.0
PITCH_HOME_DEG = 55.0
YAW_SIGN = 1.0
PITCH_SIGN = 1.0

MEASURE_ALL_OBJECTS = False

ARDUINO_PORT = "/dev/ttyUSB0"
BAUDRATE = 115200

latest = []
arduino = None

