# ============================================================
# Main processing
# ============================================================

def process_detected_objects(
    blocked_cells: List[Tuple[int, int]],
    grid: GridConfig,
    geometry: SystemGeometry,
    calibration: CalibrationConfig
) -> List[ObjectResult]:

    clusters = cluster_blocked_cells(blocked_cells)
    results: List[ObjectResult] = []

    for object_id, cluster in enumerate(clusters, start=1):

        aim_point_B = average_cluster_to_background_point(cluster, grid)

        aim_point_W = geometry.T_WB @ aim_point_B

        yaw_rad, pitch_rad, aim_point_M = pan_tilt_ik_from_target_world(
            aim_point_W,
            geometry.T_WM
        )

        yaw_kin_deg = math.degrees(yaw_rad)
        pitch_kin_deg = math.degrees(pitch_rad)

        yaw_motor_deg, pitch_motor_deg = map_kinematic_to_motor_angles(
            yaw_kin_deg,
            pitch_kin_deg,
            calibration
        )

        measured_distance_m = send_motor_angles_and_read_distance(
            yaw_motor_deg,
            pitch_motor_deg
        )

        reconstructed_point_W = reconstruct_object_point_world(
            measured_distance_m,
            yaw_rad,
            pitch_rad,
            geometry.T_WM
        )

        result = ObjectResult(
            object_id=object_id,
            blocked_cells=cluster,
            aim_point_B=aim_point_B,
            aim_point_W=aim_point_W,
            aim_point_M=aim_point_M,
            yaw_kin_deg=yaw_kin_deg,
            pitch_kin_deg=pitch_kin_deg,
            yaw_motor_deg=yaw_motor_deg,
            pitch_motor_deg=pitch_motor_deg,
            measured_distance_m=measured_distance_m,
            reconstructed_point_W=reconstructed_point_W
        )

        results.append(result)

    return results


# ============================================================
# Output printing
# ============================================================

def print_result(result: ObjectResult) -> None:
    print("\n" + "=" * 60)
    print(f"Object {result.object_id}")
    print("=" * 60)

    print(f"Blocked cells: {result.blocked_cells}")

    print("\nAiming point in background frame {B}:")
    print(f"x_B = {result.aim_point_B[0]: .3f} m")
    print(f"y_B = {result.aim_point_B[1]: .3f} m")
    print(f"z_B = {result.aim_point_B[2]: .3f} m")

    print("\nAiming point in world frame {W}:")
    print(f"x_W = {result.aim_point_W[0]: .3f} m")
    print(f"y_W = {result.aim_point_W[1]: .3f} m")
    print(f"z_W = {result.aim_point_W[2]: .3f} m")

    print("\nAiming point in mount frame {M}:")
    print(f"x_M = {result.aim_point_M[0]: .3f} m")
    print(f"y_M = {result.aim_point_M[1]: .3f} m")
    print(f"z_M = {result.aim_point_M[2]: .3f} m")

    print("\nInverse kinematics:")
    print(f"yaw_kinematic   = {result.yaw_kin_deg: .2f} deg")
    print(f"pitch_kinematic = {result.pitch_kin_deg: .2f} deg")

    print("\nMotor commands:")
    print(f"yaw_motor   = {result.yaw_motor_deg: .2f} deg")
    print(f"pitch_motor = {result.pitch_motor_deg: .2f} deg")

    print("\nLiDAR measurement:")
    print(f"distance = {result.measured_distance_m: .3f} m")

    print("\nReconstructed object point in world frame {W}:")
    print(f"x_object_W = {result.reconstructed_point_W[0]: .3f} m")
    print(f"y_object_W = {result.reconstructed_point_W[1]: .3f} m")
    print(f"z_object_W = {result.reconstructed_point_W[2]: .3f} m")


# ============================================================
# Main
# ============================================================

def main():
    print("Camera-grid-assisted 3D LiDAR aiming prototype")
    print("Single-file version with Arduino communication\n")

    # ------------------------------------------------------------
    # Arduino setup
    # ------------------------------------------------------------

    initialize_arduino("/dev/ttyUSB0", 115200)

    # ------------------------------------------------------------
    # Grid setup
    # ------------------------------------------------------------

    grid = GridConfig(
        rows=20,
        cols=20,
        square_size_m=0.03,
        origin_at_center=True
    )

    # Later, this can come from initial LiDAR measurement at home position.
    background_distance_m = 2.0

    # ------------------------------------------------------------
    # Transformation setup
    # ------------------------------------------------------------

    """
    Background frame {B}:
        x_B = horizontal grid coordinate
        y_B = vertical grid coordinate
        z_B = 0 on background plane

    World frame {W}:
        x_W = right
        y_W = forward toward background
        z_W = up

    Mapping:
        x_W = x_B
        y_W = background_distance
        z_W = y_B
    """

    R_WB = np.array([
        [1, 0, 0],
        [0, 0, 1],
        [0, 1, 0]
    ])

    p_WB = np.array([
        0.0,
        background_distance_m,
        0.0
    ])

    T_WB = T_from_R_p(R_WB, p_WB)

    # Mount frame to world frame.
    # For now, assume the mount frame is the same as world frame.
    T_WM = np.eye(4)

    geometry = SystemGeometry(
        background_distance_m=background_distance_m,
        T_WB=T_WB,
        T_WM=T_WM
    )

    # ------------------------------------------------------------
    # Calibration setup
    # ------------------------------------------------------------

    calibration = CalibrationConfig(
        yaw_home_deg=49.0,
        pitch_home_deg=55.0,

        # If yaw moves opposite direction, change yaw_sign to -1.0.
        # If pitch moves opposite direction, change pitch_sign to -1.0.
        yaw_sign=1.0,
        pitch_sign=1.0,

        yaw_scale=1.0,
        pitch_scale=1.0,

        yaw_min_deg=0.0,
        yaw_max_deg=180.0,
        pitch_min_deg=0.0,
        pitch_max_deg=180.0
    )

    print("Calibration:")
    print(f"yaw home   = {calibration.yaw_home_deg} deg")
    print(f"pitch home = {calibration.pitch_home_deg} deg")

    # ------------------------------------------------------------
    # Temporary camera detection
    # ------------------------------------------------------------

    blocked_cells = get_blocked_cells_from_camera_demo()

    print("\nDetected blocked grid cells:")
    print(blocked_cells)

    # ------------------------------------------------------------
    # Process objects
    # ------------------------------------------------------------

    results = process_detected_objects(
        blocked_cells=blocked_cells,
        grid=grid,
        geometry=geometry,
        calibration=calibration
    )

    # ------------------------------------------------------------
    # Print results
    # ------------------------------------------------------------

    for result in results:
        print_result(result)


if __name__ == "__main__":
    try:
        main()
    finally:
        close_arduino()
