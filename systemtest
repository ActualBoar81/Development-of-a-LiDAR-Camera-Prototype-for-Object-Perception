import serial
import time

arduino = serial.Serial('/dev/ttyUSB0', 115200, timeout=2)
time.sleep(2)

# Read Arduino READY message
print(arduino.readline().decode().strip())

yaw = 90
pitch = 45

command = f"ANGLE,{yaw},{pitch}\n"
arduino.write(command.encode())

response = arduino.readline().decode().strip()
print("Arduino replied:", response)

if response.startswith("DIST"):
    distance = int(response.split(",")[1])
    print("Distance:", distance)
