# ============================================================
# Main processing function
# ============================================================

def process_detected_objects(
    blocked_cells: List[Tuple[int, int]],
    grid: GridConfig,
    geometry: SystemGeometry,
    calibration: CalibrationConfig
) -> List[ObjectResult]:
    """
    Full pipeline from blocked grid cells to motor commands and 3D points.
    """

    clusters = cluster_blocked_cells(blocked_cells)

    results: List[ObjectResult] = []

    for object_id, cluster in enumerate(clusters, start=1):

        # 1. Cluster center in background frame
        aim_point_B = average_cluster_to_background_point(cluster, grid)

        # 2. Background frame to world frame
        aim_point_W = geometry.T_WB @ aim_point_B

        # 3. Inverse kinematics
        yaw_rad, pitch_rad, aim_point_M = pan_tilt_ik_from_target_world(
            aim_point_W,
            geometry.T_WM
        )

        yaw_kin_deg = math.degrees(yaw_rad)
        pitch_kin_deg = math.degrees(pitch_rad)

        # 4. Mechanical calibration mapping
        yaw_motor_deg, pitch_motor_deg = map_kinematic_to_motor_angles(
            yaw_kin_deg,
            pitch_kin_deg,
            calibration
        )

        # 5. Send motor command
        send_motor_angles_to_arduino(
            yaw_motor_deg,
            pitch_motor_deg
        )

        # 6. Wait until motors move
        wait_until_motors_reach_position()

        # 7. Read LiDAR distance
        measured_distance_m = read_lidar_distance_m()

        # 8. Reconstruct actual object point
        object_point_W = reconstruct_object_point_world(
            measured_distance_m,
            yaw_rad,
            pitch_rad,
            geometry.T_WM
        )

        result = ObjectResult(
            object_id=object_id,
            blocked_cells=cluster,
            aim_point_B=aim_point_B,
            aim_point_W=aim_point_W,
            aim_point_M=aim_point_M,
            yaw_kin_deg=yaw_kin_deg,
            pitch_kin_deg=pitch_kin_deg,
            yaw_motor_deg=yaw_motor_deg,
            pitch_motor_deg=pitch_motor_deg,
            measured_distance_m=measured_distance_m,
            reconstructed_point_W=object_point_W
        )

        results.append(result)

    return results


