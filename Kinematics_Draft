    print("\n" + "=" * 60)
    print(f"Object {result.object_id}")
    print("=" * 60)

    print(f"Blocked cells: {result.blocked_cells}")

    print("\nAiming point on background frame {B}:")
    print(f"x_B = {result.aim_point_B[0]: .3f} m")
    print(f"y_B = {result.aim_point_B[1]: .3f} m")
    print(f"z_B = {result.aim_point_B[2]: .3f} m")

    print("\nAiming point in world frame {W}:")
    print(f"x_W = {result.aim_point_W[0]: .3f} m")
    print(f"y_W = {result.aim_point_W[1]: .3f} m")
    print(f"z_W = {result.aim_point_W[2]: .3f} m")

    print("\nAiming point in mount frame {M}:")
    print(f"x_M = {result.aim_point_M[0]: .3f} m")
    print(f"y_M = {result.aim_point_M[1]: .3f} m")
    print(f"z_M = {result.aim_point_M[2]: .3f} m")

    print("\nInverse kinematics angles:")
    print(f"yaw_kinematic   = {result.yaw_kin_deg: .2f} deg")
    print(f"pitch_kinematic = {result.pitch_kin_deg: .2f} deg")

    print("\nMapped motor angles:")
    print(f"yaw_motor   = {result.yaw_motor_deg: .2f} deg")
    print(f"pitch_motor = {result.pitch_motor_deg: .2f} deg")

    print("\nLiDAR measurement:")
    print(f"distance = {result.measured_distance_m: .3f} m")

    print("\nReconstructed real object point in world frame {W}:")
    print(f"x_object_W = {result.reconstructed_point_W[0]: .3f} m")
    print(f"y_object_W = {result.reconstructed_point_W[1]: .3f} m")
    print(f"z_object_W = {result.reconstructed_point_W[2]: .3f} m")


# ============================================================
# Main
# ============================================================

def main():
    print("Camera-grid-assisted 3D LiDAR aiming prototype")
    print("Single-file demonstrator\n")

    # ------------------------------------------------------------
    # 1. System configuration
    # ------------------------------------------------------------

    grid = GridConfig(
        rows=20,
        cols=20,
        square_size_m=0.03,   # 30 mm square size
        origin_at_center=True
    )

    # This should later come from startup LiDAR measurement.
    background_distance_m = 2.0

    # Background frame {B} to world frame {W}
    #
    # Background frame:
    #   x_B = horizontal grid coordinate
    #   y_B = vertical grid coordinate
    #   z_B = 0 on plane
    #
    # World frame:
    #   x_W = right
    #   y_W = forward
    #   z_W = up
    #
    # Therefore:
    #   x_W = x_B
    #   y_W = background_distance
    #   z_W = y_B
    #
    # Rotation columns describe where B axes appear in W:
    #   B x-axis maps to W x-axis: [1, 0, 0]
    #   B y-axis maps to W z-axis: [0, 0, 1]
    #   B z-axis maps to W y-axis: [0, 1, 0]
    R_WB = np.array([
        [1, 0, 0],
        [0, 0, 1],
        [0, 1, 0]
    ])

    p_WB = np.array([
        0.0,
        background_distance_m,
        0.0
    ])

    T_WB = T_from_R_p(R_WB, p_WB)

    # Mount frame {M} to world frame {W}
    #
    # For first prototype, assume mount frame is equal to world frame.
    # If the mount is physically shifted, add its position here.
    #
    # Example offset:
    #   p_WM = np.array([0.02, 0.00, 0.04])
    #
    # For now:
    T_WM = np.eye(4)

    geometry = SystemGeometry(
        background_distance_m=background_distance_m,
        T_WB=T_WB,
        T_WM=T_WM
    )

    # ------------------------------------------------------------
    # 2. Calibration
    # ------------------------------------------------------------

    calibration = CalibrationConfig(
        yaw_home_deg=49.0,
        pitch_home_deg=55.0,

        # Change these to -1 if motor moves opposite direction.
        yaw_sign=1.0,
        pitch_sign=1.0,

        # Use scale factors only if edge positions are inaccurate.
        yaw_scale=1.0,
        pitch_scale=1.0,

        yaw_min_deg=0.0,
        yaw_max_deg=180.0,
        pitch_min_deg=0.0,
        pitch_max_deg=180.0
    )

    print("Calibration:")
    print(f"Home yaw motor angle   = {calibration.yaw_home_deg} deg")
    print(f"Home pitch motor angle = {calibration.pitch_home_deg} deg")

    # ------------------------------------------------------------
    # 3. Temporary camera/grid detection
    # ------------------------------------------------------------

    blocked_cells = get_blocked_cells_from_camera_demo()

    print("\nDetected blocked grid cells:")
    print(blocked_cells)

    # ------------------------------------------------------------
    # 4. Process objects
    # ------------------------------------------------------------

    results = process_detected_objects(
        blocked_cells=blocked_cells,
        grid=grid,
        geometry=geometry,
        calibration=calibration
    )

    # ------------------------------------------------------------
    # 5. Print results
    # ------------------------------------------------------------

    for result in results:
        print_result(result)


if __name__ == "__main__":
    main()
